# Packaged defaults. Flip with edge/rpi5/sb_runtime.sh or set_pi_runtime.ps1
# (see edge/cpp/PI_BRINGUP.md). Do not hand-edit unless the helpers are missing.
SOUNDBUBBLE_ROOT=/home/sonitude/sb_rt_dev
SOUNDBUBBLE_RUNTIME=python
SOUNDBUBBLE_RT_BIN=/opt/soundbubble/bin/soundbubble-rt
SOUNDBUBBLE_PYTHON=/home/sonitude/Sonitude/Sound_Bubble/.venv/bin/python
SOUNDBUBBLE_LOG_DIR=/var/lib/soundbubble/logs
INPUT_DEVICE=0
OUTPUT_DEVICE=0
INPUT_SR=24000
OUTPUT_SR=24000
# Provisional after Pico 32-bit + makeup: start at 0 dB; retune from model_in_db.
INPUT_GAIN_DB=35
SILENCE_DBFS=-80
