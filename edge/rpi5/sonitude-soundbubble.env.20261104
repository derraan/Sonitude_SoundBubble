# STAGED service env (2026-11-04). Not installed. To adopt, the owner runs:
#   sudo cp /etc/sonitude-soundbubble.env /etc/sonitude-soundbubble.env.bak_20261104
#   sudo cp ~/sb_rt_stage_20261104/run/sonitude-soundbubble.env.20261104 /etc/sonitude-soundbubble.env
#   sudo systemctl restart sonitude-soundbubble
# Changes vs the live /etc file are marked CHANGED.

SOUNDBUBBLE_ROOT=/home/sonitude/sb_rt_dev
SOUNDBUBBLE_PYTHON=/home/sonitude/Sonitude/Sound_Bubble/.venv/bin/python
SOUNDBUBBLE_LOG_DIR=/home/sonitude/sb_rt_dev/logs
SOUNDBUBBLE_RUNTIME=cpp
SOUNDBUBBLE_MODEL=edge/zoo/optim_sonitude_dist_count_1_5m_ep35.onnx
SOUNDBUBBLE_CONTRACT=edge/zoo/optim_sonitude_dist_count_1_5m_ep35.runtime.json
# CHANGED: 2026-11-04 build (declick ring, limiter hold, residual gate, mic gains, tap fixes).
# Bit-parity with the Windows bench build verified on a 1 m speech take.
SOUNDBUBBLE_RT_BIN=/home/sonitude/sb_rt_stage_20261104/edge/cpp/build/pi/soundbubble-rt

INPUT_DEVICE=0
OUTPUT_DEVICE=0
INPUT_SR=24000
OUTPUT_SR=24000
# CHANGED 35 -> 15 + MIC_GAINS: the bench chain the owner validated by ear (same Pico + headset).
INPUT_GAIN_DB=15
# CHANGED: wideband-only calibration (dev ch2 -12.6 dB, ch5 -12.9 dB), linear, DEVICE order.
# Re-check with run/pi_mic_check.py after any replug; dev ch4 can toggle low.
MIC_GAINS=1.514,1.514,6.457,1.514,1.514,6.683
SILENCE_DBFS=-80
OUTPUT_GAIN_DB=15
MIX_DRY=0.0
# CHANGED 0,1,2,3,4,5 -> owner canon edge/MIC_INDEX_CANON.md §4 (left ear = USB ch5).
CHANNEL_MAP=5,4,3,2,1,0
MIX_UART_PORT=/dev/ttyACM0
MIX_UART_BAUD=115200
# Optional: record every service run (raw 8ch + wet) into a new timestamped folder.
# TAP_DIR=/mnt/sonitude-drive/sonitude-recordings/service
