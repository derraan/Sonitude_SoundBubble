[Unit]
Description=Sound Bubble Remote Controller
After=network-online.target tailscaled.service
Wants=network-online.target
# The C++ Sonitude pipeline holds the Pico and DAC; only one may run.
Conflicts=sonitude.service

[Service]
Type=simple
User=sonitude
WorkingDirectory=/home/sonitude/Sonitude/Sound_Bubble
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/soundbubble-controller.env
ExecStart=/home/sonitude/Sonitude/Sound_Bubble/.venv/bin/python -m edge.controller.app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target

